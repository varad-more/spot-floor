# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments (uv also writes .venv/.gitignore, this is belt-and-suspenders)
.venv/
venv/

# SQLite / local time-series stores
*.db
*.db-wal
*.db-shm
ec2-spot-prices.db

# Secrets & credentials — never commit; AWS creds live in ~/.aws, keep it that way
.env
.env.*
*.pem
credentials
aws_credentials

# Rendered static snapshot (built by scripts/snapshot.py, deployed by CI)
site/
# public/ IS committed: it is the sample snapshot GitHub Pages serves, generated
# locally so no AWS credentials ever go near this repository.

# Knowledge-graph build output (graphify) -- derived from the repo, rebuildable
graphify-out/

# OS / editor cruft
.DS_Store
.idea/
.vscode/
